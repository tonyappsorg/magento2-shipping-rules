<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <preference for="Tonyapps\ShippingRules\Api\Data\RuleInterface"
                type="Tonyapps\ShippingRules\Model\Rule"/>
    <preference for="Tonyapps\ShippingRules\Api\RuleRepositoryInterface"
                type="Tonyapps\ShippingRules\Model\RuleRepository"/>
    <preference for="Tonyapps\ShippingRules\Model\Rule\Io\ExporterInterface"
                type="Tonyapps\ShippingRules\Model\Rule\Io\JsonExporter"/>
    <preference for="Tonyapps\ShippingRules\Model\Rule\Io\ImporterInterface"
                type="Tonyapps\ShippingRules\Model\Rule\Io\JsonImporter"/>

    <type name="Tonyapps\ShippingRules\Model\Rule\Io\ExporterPool">
        <arguments>
            <argument name="exporters" xsi:type="array">
                <item name="json" xsi:type="object">Tonyapps\ShippingRules\Model\Rule\Io\JsonExporter</item>
                <item name="csv" xsi:type="object">Tonyapps\ShippingRules\Model\Rule\Io\CsvExporter</item>
            </argument>
        </arguments>
    </type>
    <type name="Tonyapps\ShippingRules\Model\Rule\Io\ImporterPool">
        <arguments>
            <argument name="importers" xsi:type="array">
                <item name="json" xsi:type="object">Tonyapps\ShippingRules\Model\Rule\Io\JsonImporter</item>
                <item name="csv" xsi:type="object">Tonyapps\ShippingRules\Model\Rule\Io\CsvImporter</item>
            </argument>
        </arguments>
    </type>
    <type name="Magento\Shipping\Model\Shipping">
        <plugin name="tonyapps_shippingrules_hide_methods"
                type="Tonyapps\ShippingRules\Plugin\Shipping\HideMethodsPlugin" sortOrder="10"/>
    </type>
    <type name="Tonyapps\ShippingRules\Model\ResourceModel\Rule\Grid\Collection">
        <arguments>
            <argument name="mainTable" xsi:type="string">tonyapps_shipping_rule</argument>
            <argument name="resourceModel" xsi:type="string">Tonyapps\ShippingRules\Model\ResourceModel\Rule</argument>
            <argument name="eventPrefix" xsi:type="string">tonyapps_shipping_rule_grid_collection</argument>
            <argument name="eventObject" xsi:type="string">shipping_rule_grid_collection</argument>
        </arguments>
    </type>
    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="tonyapps_shipping_rule_listing_data_source" xsi:type="string">Tonyapps\ShippingRules\Model\ResourceModel\Rule\Grid\Collection</item>
            </argument>
        </arguments>
    </type>
</config>
