<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="tonyapps_shipping_rule" resource="default" engine="innodb" comment="Tonyapps Shipping Rules">
        <column xsi:type="int" name="rule_id" unsigned="true" nullable="false" identity="true" comment="Rule ID"/>
        <column xsi:type="varchar" name="name" nullable="false" length="255" comment="Rule Name"/>
        <column xsi:type="text" name="description" nullable="true" comment="Description"/>
        <column xsi:type="smallint" name="is_active" unsigned="true" nullable="false" default="1" comment="Is Active"/>
        <column xsi:type="int" name="sort_order" unsigned="true" nullable="false" default="0" comment="Sort Order"/>
        <column xsi:type="varchar" name="action" nullable="false" length="32" default="hide"
                comment="Rule Action: hide | contact_store"/>
        <column xsi:type="text" name="applies_to_methods" nullable="true"
                comment="Comma-separated carrier_method codes the rule targets; empty = all methods"/>
        <column xsi:type="smallint" name="hide_others" unsigned="true" nullable="false" default="0"
                comment="For contact_store action: hide all other methods when this rule matches"/>
        <column xsi:type="mediumtext" name="conditions_serialized" nullable="true" comment="Serialized Conditions"/>
        <column xsi:type="mediumtext" name="actions_serialized" nullable="true" comment="Serialized Actions"/>
        <column xsi:type="text" name="customer_group_ids" nullable="true"
                comment="Comma-separated customer group IDs; empty = all groups"/>
        <column xsi:type="text" name="store_ids" nullable="true"
                comment="Comma-separated store view IDs; empty = all stores"/>
        <column xsi:type="date" name="from_date" nullable="true" comment="Active From"/>
        <column xsi:type="date" name="to_date" nullable="true" comment="Active To"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP"
                on_update="true" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="rule_id"/>
        </constraint>
        <index referenceId="TONYAPPS_SHIPPING_RULE_IS_ACTIVE_SORT_ORDER" indexType="btree">
            <column name="is_active"/>
            <column name="sort_order"/>
        </index>
    </table>
</schema>
